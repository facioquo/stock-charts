{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Test-only. `backing-api.spec.ts` reads files off disk; the build tsconfig
    // keeps `types: []` so none of this reaches the shipped library.
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
