{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Test- and config-only. `eslint.config.ts` reads `import.meta.dirname`; the
    // build tsconfig keeps `types: []` so none of this reaches the shipped library.
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
