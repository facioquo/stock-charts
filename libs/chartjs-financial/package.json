{
  "name": "@facioquo/chartjs-chart-financial",
  "version": "0.1.2",
  "private": true,
  "description": "Financial charting extension for Chart.js (candlestick, OHLC, volume charts)",
  "author": "facioquo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/facioquo/stock-charts.git",
    "directory": "libs/chartjs-financial"
  },
  "homepage": "https://github.com/facioquo/stock-charts/tree/main/libs/chartjs-financial#readme",
  "bugs": {
    "url": "https://github.com/facioquo/stock-charts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
