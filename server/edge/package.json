{
  "name": "@stock-charts/edge",
  "description": "Cloudflare Worker fronting the indicator API container and refreshing quote datasets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .wrangler node_modules/.vite",
    "format": "prettier --write \"src/**/*.ts\" wrangler.jsonc",
    "format:check": "prettier --check \"src/**/*.ts\" wrangler.jsonc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
