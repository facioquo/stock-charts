{
  "name": "@stock-charts/web",
  "private": true,
  "description": "React + Vite frontend for stock charts application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html,scss,css,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@facioquo/indy-charts": "workspace:*",
    "chart.js": "~4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
