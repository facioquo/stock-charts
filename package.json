{
  "name": "stock-charts",
  "description": "Full-stack financial charting application with React frontend and .NET backend",
  "author": "facioquo",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facioquo/stock-charts.git"
  },
  "scripts": {
    "postinstall": "node scripts/setup-playwright-mcp.cjs",
    "clean": "rm -rf node_modules .codacy && pnpm -r run clean",
    "deps:check": "ncu --deep --peer",
    "deps:update": "ncu --deep --peer --target semver --upgrade",
    "prebuild": "node scripts/generate-backup-indicators.js",
    "build": "pnpm -r run build",
    "prebuild:prod": "node scripts/generate-backup-indicators.js",
    "build:prod": "pnpm -r --if-present run build:prod",
    "start": "pnpm --filter @stock-charts/web run start",
    "serve": "pnpm --filter @stock-charts/web run dev",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @stock-charts/playwright-tests run test:e2e",
    "test:watch": "pnpm -r run test:watch",
    "test:coverage": "pnpm --filter @stock-charts/web run test:coverage",
    "test:libs": "pnpm --filter @facioquo/chartjs-chart-financial --filter @facioquo/indy-charts run test",
    "pretest:dotnet": "dotnet tool restore && rm -rf server/coverage",
    "test:dotnet": "dotnet test server/WebApi.Tests/WebApi.Tests.csproj --results-directory ./server/coverage --coverlet --coverlet-output-format cobertura --coverlet-output-format lcov --report-xunit-trx --report-xunit-trx-filename backend.trx && (dotnet tool run reportgenerator -reports:server/coverage/coverage.cobertura*.xml -targetdir:server/coverage -reporttypes:\"lcov;TextSummary\" 2>&1 | grep -v 'LoggerMessage.g.cs' || true) && echo && cat server/coverage/Summary.txt",
    "test:all": "pnpm --filter @stock-charts/web run test:coverage && pnpm run test:libs && pnpm run test:dotnet && pnpm run test:e2e",
    "smoke:package-consumption": "node scripts/smoke-indy-charts-vitepress-consumer.js",
    "lint": "bash scripts/website-lint.sh check && pnpm run lint:dotnet && pnpm run lint:md",
    "lint:fix": "bash scripts/website-lint.sh fix && pnpm run lint:dotnet:fix && pnpm run lint:md:fix",
    "lint:dotnet": "bash scripts/dotnet-lint.sh check",
    "lint:dotnet:fix": "bash scripts/dotnet-lint.sh fix",
    "generate:backup-indicators": "node scripts/generate-backup-indicators.js",
    "bench:chart-config": "node scripts/bench-chart-config.js",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:css": "stylelint \"**/*.{css,scss}\" --ignore-pattern \"**/coverage/**\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss}\" --ignore-pattern \"**/coverage/**\" --fix",
    "format": "pnpm run format:web && pnpm run format:dotnet",
    "format:check": "pnpm run format:web:check && pnpm run format:dotnet:check",
    "format:web": "pnpm --filter @stock-charts/web run format && prettier --write .vscode/**/*.json",
    "format:web:check": "pnpm --filter @stock-charts/web run format:check && prettier --check .vscode/**/*.json",
    "format:dotnet": "dotnet format Charts.sln",
    "format:dotnet:check": "dotnet format Charts.sln --verify-no-changes",
    "format:staged": "prettier --write",
    "format:vscode": "prettier --write --no-ignore \".vscode/*.json\"",
    "dev": "pnpm --filter @stock-charts/web run dev",
    "edge:dev": "pnpm --filter @stock-charts/edge run dev",
    "edge:deploy": "pnpm --filter @stock-charts/edge run deploy",
    "stop:services": "node scripts/stop-services.js"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "npm-check-updates": "^23.1.0",
    "@playwright/test": "1.62.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "^6.0.3"
  }
}
